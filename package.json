{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cadence — MVP de gestion des droits intermittents (Annexe 10)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "verifier:rls": "node --env-file=.env scripts/verifier-rls.mjs",
    "verifier:verrou": "node --env-file=.env scripts/verifier-verrou.mjs",
    "verifier:sauvegarde": "node --env-file=.env scripts/verifier-sauvegarde-serveur.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "date-fns": "^3.6.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.6.0"
  }
}
